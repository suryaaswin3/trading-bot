# ── Ops API Production Configuration ──────────────────────────────────────
# Copy to /opt/trading-bot/.env and fill in secrets.
#
#   cp deployment/env.production /opt/trading-bot/.env
#   nano /opt/trading-bot/.env

# ── Server ────────────────────────────────────────────────────────────────
OA_HOST=0.0.0.0
OA_PORT=8080
OA_RELOAD=false
OA_LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────
OA_DB_PATH=/opt/trading-bot/ops_data.db
OA_DB_POOL_TIMEOUT=5.0
OA_RETENTION_DAYS=90

# ── Authentication ───────────────────────────────────────────────────────
OA_API_KEY=CHANGE_ME_GENERATE_STRONG_KEY
OA_WEBHOOK_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# ── Dashboard ────────────────────────────────────────────────────────────
OA_DASHBOARD_PORT=8501
OA_DASHBOARD_USERNAME=admin
OA_DASHBOARD_PASSWORD=CHANGE_ME

# ── Telegram ─────────────────────────────────────────────────────────────
# Get token from @BotFather, chat ID from @userinfobot
OA_TELEGRAM_BOT_TOKEN=
OA_TELEGRAM_CHAT_ID=

# ── Trading ──────────────────────────────────────────────────────────────
OA_ALLOWED_SYMBOLS=NIFTY,BANKNIFTY
OA_MAX_STALENESS_SECONDS=300
OA_FLATTEN_ON_KILL=false

# ── Strategy Engine ──────────────────────────────────────────────────────
OA_USE_STRATEGY_ENGINE=true

# ── Scanner ──────────────────────────────────────────────────────────────
OA_SCANNER_ENABLED=true
OA_SCANNER_INTERVAL_SECONDS=60
OA_SCANNER_SYMBOLS=NIFTY,BANKNIFTY
OA_AUTO_MARKET_DETECTION=true

# ── VPS Role ─────────────────────────────────────────────────────────────
# "all"  = scanner + API (legacy combined mode)
# "api"  = API + dashboard only (scanner runs as separate process)
# "scanner" = standalone scanner process (via scanner_runner.py)
OA_ROLE=api

# ── Live Trading (REQUIRES EXPLICIT OPT-IN) ──────────────────────────────
OA_LIVE_TRADING=false
# Set to "true" only after verifying everything works in paper mode!

# ── Logging ──────────────────────────────────────────────────────────────
OA_LOG_DIR=/var/log/trading-bot